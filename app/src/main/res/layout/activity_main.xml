<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#FFF8E1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">
    <TextView
        android:id="@+id/tv_titre_main_kh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DOUANE TEMPORELLE"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#6D4C41"
        android:layout_marginBottom="24dp" />
    <EditText
        android:id="@+id/et_nom_kh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nom du voyageur" />

    <EditText
        android:id="@+id/et_naissance_kh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Année de naissance (ex: 1990)"
        android:inputType="number" />

    <EditText
        android:id="@+id/et_destination_kh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Année de destination (ex: 2050)"
        android:inputType="number" />

    <Spinner
        android:id="@+id/sp_motif_kh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:backgroundTint="#6D4C41"
        android:id="@+id/btn_inspecter_kh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Inspecter le profil" />
</LinearLayout>